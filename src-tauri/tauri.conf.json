{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cabina",
  "version": "0.1.0",
  "identifier": "app.cabina.dj",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cabina",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "backgroundColor": "#0b0d11",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.music",
    "shortDescription": "Software DJ con motor de audio nativo",
    "copyright": "© 2026",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
